# hello-rectangle.cdx - minimal example script, demonstrating --vars.
# Same grammar as the interactive shell, one command per line, no `corel` prefix.
#
# Run with defaults:
#   corel script run scripts/samples/hello-rectangle.cdx --vars WIDTH=12,HEIGHT=19,UNIT=in
#
# Any {PLACEHOLDER} here is substituted from --vars KEY=VALUE,... before running - try
# a different size, e.g. --vars WIDTH=8,HEIGHT=10,UNIT=in

doc new
page size --width {WIDTH} --height {HEIGHT} --unit {UNIT}
shape create-rect --left 0 --top {HEIGHT} --right {WIDTH} --bottom 0 --unit {UNIT}
shape list
